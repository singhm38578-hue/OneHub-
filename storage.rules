rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Default deny everything
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isVerifiedOwner(userId) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.uid == userId;
    }

    function isValidImageUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('^image/(jpeg|png|webp)$');
    }

    // User Post Images (publicly readable, owner-only verified write <= 2 MB)
    match /uploads/{userId}/posts/{fileName} {
      allow read: if true;
      allow create, update: if isVerifiedOwner(userId)
        && fileName.size() <= 128
        && fileName.matches('^[a-zA-Z0-9_\\-\\.]+$')
        && isValidImageUpload();
      allow delete: if isVerifiedOwner(userId);
    }

    // User Profile Avatars (publicly readable, owner-only verified write <= 2 MB)
    match /uploads/{userId}/avatars/{fileName} {
      allow read: if true;
      allow create, update: if isVerifiedOwner(userId)
        && fileName.size() <= 128
        && fileName.matches('^[a-zA-Z0-9_\\-\\.]+$')
        && isValidImageUpload();
      allow delete: if isVerifiedOwner(userId);
    }
  }
}
